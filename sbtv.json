{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "http_clients": [
    {
      "tag": "proxy-http-client",
      "detour": "Final"
    }
  ],
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "proxy-dns",
        "server": "1.1.1.1",
        "path": "/dns-query",
        "detour": "Final"
      },
      {
        "type": "udp",
        "tag": "local-dns",
        "server": "223.5.5.5"
      },
      {
        "type": "fakeip",
        "tag": "fakeip",
        "inet4_range": "198.18.0.0/15"
      }
    ],
    "rules": [
			{
        "rule_set": "Direct",
        "action": "route",
        "server": "local_dns"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "fakeip"
      }
    ],
    "final": "proxy-dns"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "Final",
      "outbounds": [
        "🇸🇬 AZ",
			  "🇸🇬 SHARON",
        "🇯🇵 ORA",
        "🇺🇸 AZ"
      ],
      "default": "🇸🇬 SHARON"
    },
    {
      "type": "snell",
      "tag": "🇸🇬 AZ",
      "server": "4.193.185.80",
      "server_port": 8443,
      "psk": "AijHCeos15IvqDZTb1cJMX5GcgZzIVE",
      "version": 6
    },
    {
      "type": "snell",
      "tag": "🇺🇸 AZ",
      "server": "2a01:111:f100:3000::a83e:1a1a",
      "server_port": 8443,
      "psk": "ojde3seFNX9XtkeQiDmyXBRQdqwsXUk2k0W77m1QpHpFQ28e",
      "version": 6
    },
    {
      "type": "snell",
      "tag": "🇯🇵 ORA",
      "server": "2603:c023:11:1b88:0:e296:613f:f2f7",
      "server_port": 8443,
      "psk": "TX2DF0bYieya1VuMam2WnBO72Xsiy4ye15gFkgcazZDJ6O44",
      "version": 6
    },
    {
      "type": "snell",
      "tag": "🇸🇬 SHARON",
      "server": "172.99.138.16",
      "server_port": 8443,
      "psk": "AijHCeos15IvqDZTb1cJMX5GcgZzIVE",
      "version": 6
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "default_domain_resolver": {
      "server": "local-dns",
      "strategy": "prefer_ipv4"
    },
    "default_http_client": "proxy-http-client",
    "rule_set": [
      {
        "tag": "Direct",
        "type": "remote",
        "format": "binary",
        "url": "https://github.com/Simondler/Surge/raw/refs/heads/sb/Direct.srs"
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/cn.srs"
      },
      {
        "tag": "Proxy",
        "type": "remote",
        "format": "binary",
        "url": "https://github.com/Simondler/Surge/raw/refs/heads/sb/tvproxy.srs"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "protocol": "quic",
        "action": "reject"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "Final"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "Direct"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "Proxy"
        ],
        "action": "route",
        "outbound": "Final"
      },
      {
        "action": "resolve",
        "server": "local-dns"
      },
      {
        "rule_set": [
          "geoip-cn"
        ],
        "action": "route",
        "outbound": "direct"
      }
    ],
    "final": "Final",
    "auto_detect_interface": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
			"store_dns": true
    }
  }
}
